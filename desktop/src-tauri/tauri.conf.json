{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Island",
  "version": "0.0.1",
  "identifier": "io.github.codexedu",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Codex Island", "width": 360, "height": 36, "minWidth": 360, "minHeight": 36, "resizable": false, "decorations": false, "transparent": true, "alwaysOnTop": true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.ico"], "shortDescription": "Codex quota monitor", "category": "Utility" }
}
